# Copied to .env by `make up` the first time. Every value here is a throwaway for a container on this machine.
# Nothing in this file is a real secret; change the password if you share the machine.

POSTGRES_PORT=55531
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=local-only-password

# What the application reads (Spring Boot maps these in application.yml).
DB_URL=jdbc:postgresql://localhost:55531/catalog
DB_USER=catalog
DB_PASSWORD=local-only-password

# The job: items per transaction, skips allowed over the whole step, attempts for a transient write failure, and the
# lesson's step 6 fault (0 off, 50 makes every fiftieth chunk fail once).
IMPORT_CHUNK_SIZE=1000
IMPORT_SKIP_LIMIT=500
IMPORT_RETRY_LIMIT=3
IMPORT_TRANSIENT_FAULT_EVERY_NTH_CHUNK=0
